# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database: SQL Server Express on Somee (ENV-2) -------------------------
# ODBC Driver 17 is installed on this machine; 18 also works but defaults to
# Encrypt=yes and then usually needs TrustServerCertificate=yes appended.
SOMEE_DB_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SERVER.somee.com;Database=YOUR_DB;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;"

# --- LLM and web search ---------------------------------------------------
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# --- Vector store: Chroma in server mode (ENV-4) --------------------------
CHROMA_HOST="localhost"
CHROMA_PORT="8000"

# --- Embeddings -----------------------------------------------------------
# "openai" -> text-embedding-3-small, 1536 dims, needs OPENAI_API_KEY
# "ollama" -> qwen3-embedding:0.6b, 1024 dims, no key, needs Ollama running
# Both index Hebrew natively (NFR-VEC-4). Model and dimension follow from the
# provider, so switching is this one line.
EMBEDDING_PROVIDER="openai"

# Only read when EMBEDDING_PROVIDER="ollama".
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# Overrides for an unlisted model. Leave both unset unless you need them: they
# must agree with each other and with the provider, and a wrong pairing yields
# vectors that are silently incomparable.
# EMBEDDING_MODEL=""
# EMBEDDING_DIM=""

# --- Application ----------------------------------------------------------
FLASK_SECRET_KEY=""
AGENT_POLL_SECONDS="60"
QUALITY_FLOOR="60"
