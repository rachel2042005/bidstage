# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database: SQL Server Express on Somee (ENV-2) -------------------------
# ODBC Driver 17 is installed on this machine; 18 also works but defaults to
# Encrypt=yes and then usually needs TrustServerCertificate=yes appended.
SOMEE_DB_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SERVER.somee.com;Database=YOUR_DB;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;"

# --- LLM and web search ---------------------------------------------------
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# --- Vector store: Chroma in server mode (ENV-4) --------------------------
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM="1536"

# --- Application ----------------------------------------------------------
FLASK_SECRET_KEY=""
AGENT_POLL_SECONDS="60"
QUALITY_FLOOR="60"
